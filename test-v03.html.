<!doctype html><html lang="sv"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Royson Smart Home v0.3</title><style>:root{font-family:system-ui,-apple-system,sans-serif;color-scheme:dark;--bg:#0b1428;--card:#1a2b45;--text:#f3f6ff;--muted:#a9bad3;--border:#344760}body.light{color-scheme:light;--bg:#f0f5fa;--card:#fff;--text:#18263d;--muted:#64748b;--border:#dce4ed}body{background:var(--bg);color:var(--text);margin:0}main{max-width:780px;margin:auto;padding:24px 18px 90px}header{display:flex;justify-content:space-between;align-items:center;gap:12px}h1{font-size:25px;margin:8px 0}h2{font-size:19px;margin:25px 0 12px}.muted{color:var(--muted)}.card{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:18px;margin:12px 0}.tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.tabs button{padding:15px 5px;min-height:70px}button,select,input{font:inherit}button,select{border:1px solid var(--border);border-radius:12px;background:var(--card);color:var(--text);padding:10px;cursor:pointer}.active{outline:2px solid #55b5ec}button:focus-visible{outline:3px solid #55b5ec}.row{display:flex;justify-content:space-between;align-items:center;gap:10px}.rooms{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px}.room{border:1px solid var(--border);border-radius:14px;padding:12px}.on{color:#67ddb4}.notice{font-size:13px;color:var(--muted)}input{background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:10px;padding:10px;min-width:0;flex:1}.controls{display:flex;gap:8px;flex-wrap:wrap}</style></head><body><main><header><div><div class="muted">MITT SMARTA HEM</div><h1>Royson Smart Home 🏠</h1><div class="muted">Version 0.3 · Demo</div></div><select id="theme" aria-label="Utseende"><option value="auto">Automatiskt</option><option value="light">Ljust</option><option value="dark">Mörkt</option></select></header><div class="card notice">Demoläge: alla enheter och kommandon är simulerade. Ingen verklig utrustning styrs.</div><h2>Våningsplan</h2><div class="tabs" id="floors"></div><section class="card"><div class="row"><h2 id="floorTitle" style="margin:0"></h2><button id="allOff">Släck våningsplanet</button></div><p class="muted" id="floorCount"></p><div class="rooms" id="rooms"></div><h2>Lägg till rum</h2><div class="controls"><input id="roomName" placeholder="Namn på rum" aria-label="Namn på rum"><button id="addRoom">Lägg till</button></div></section><p class="notice">Rum och simulerade lampor sparas lokalt i denna webbläsare. Framtida Plejd-, Smart Life- och Roborock-integrationer kräver separat säker anslutning.</p></main><script>const floorNames=['Källare','Entré','Övervåning'];const defaults={'Källare':['Källartrapp','Tvättstuga'],'Entré':['Hall','Kök','Vardagsrum'],'Övervåning':['Sovrum','Hall övervåning']};let data;try{data=JSON.parse(localStorage.getItem('royson-v03-floors'))||null}catch{}if(!data||typeof data!=='object')data=Object.fromEntries(floorNames.map(f=>[f,defaults[f].map(name=>({name,on:false}))]));for(const f of floorNames)if(!Array.isArray(data[f]))data[f]=defaults[f].map(name=>({name,on:false}));let selected='Entré';const $=id=>document.getElementById(id);function save(){localStorage.setItem('royson-v03-floors',JSON.stringify(data))}function render(){ $('floors').replaceChildren();floorNames.forEach((f,i)=>{const b=document.createElement('button');b.textContent=['⬇️ ','🏠 ','⬆️ '][i]+f;b.className=selected===f?'active':'';b.onclick=()=>{selected=f;render()};$('floors').append(b)});$('floorTitle').textContent=selected;$('floorCount').textContent=data[selected].filter(r=>r.on).length+' av '+data[selected].length+' simulerade lampor på';$('rooms').replaceChildren();data[selected].forEach((r,i)=>{const c=document.createElement('div');c.className='room';const title=document.createElement('strong');title.textContent=r.name;const p=document.createElement('p');p.textContent=r.on?'● På':'○ Av';p.className=r.on?'on':'muted';const b=document.createElement('button');b.textContent=r.on?'Släck':'Tänd';b.onclick=()=>{r.on=!r.on;save();render()};c.append(title,p,b);$('rooms').append(c)})} $('allOff').onclick=()=>{data[selected].forEach(r=>r.on=false);save();render()};$('addRoom').onclick=()=>{const name=$('roomName').value.trim();if(!name)return;data[selected].push({name,on:false});$('roomName').value='';save();render()};const theme=$('theme');theme.value=localStorage.getItem('royson-theme')||'auto';function setTheme(){document.body.classList.toggle('light',theme.value==='light'||theme.value==='auto'&&matchMedia('(prefers-color-scheme: light)').matches)}theme.onchange=()=>{localStorage.setItem('royson-theme',theme.value);setTheme()};matchMedia('(prefers-color-scheme: light)').addEventListener('change',setTheme);setTheme();render();</script></body></html>
